# Copiare in .env fuori dal repository. Non inserire credenziali reali nel controllo versione.
INSIEME_COOKIE_SECURE=true
INSIEME_PUBLIC_URL=https://insieme.example.com
# Token del tunnel Cloudflare dedicato a questo progetto (Zero Trust > Networks > Tunnels).
# Usato dal servizio "cloudflared" in compose.yaml; non condividerlo, non committarlo.
CLOUDFLARE_TUNNEL_TOKEN=
INSIEME_TELEGRAM_BOT_TOKEN=
INSIEME_HERMES_URL=http://host.docker.internal:8000
INSIEME_HERMES_API_KEY=
INSIEME_HERMES_MODEL=insieme
INSIEME_HERMES_EMAIL_URL=
INSIEME_HERMES_EMAIL_API_KEY=
INSIEME_HERMES_EMAIL_MODEL=insieme-email
INSIEME_STT_URL=
INSIEME_STT_API_KEY=
INSIEME_STT_MODEL=whisper-large-v3-turbo
INSIEME_GOOGLE_CLIENT_ID=
INSIEME_GOOGLE_CLIENT_SECRET=
INSIEME_GOOGLE_TOKEN_KEY=
